{
  "name": "carcrashapi",
  "version": "0.0.0",
  "private": true,
  "description": "REST API for US car crash data",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "bundle:lambda": "esbuild src/lambda.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/lambda/index.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:docker": "bash scripts/docker-smoke-test.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "data:load": "tsx --env-file-if-exists=.env src/cli/load.ts",
    "data:seed": "tsx --env-file-if-exists=.env src/cli/load.ts --file fixtures/crashes.csv",
    "fixture:generate": "tsx scripts/generate-fixture.ts",
    "openapi": "tsx scripts/export-openapi.ts",
    "test:lambda": "node scripts/lambda-smoke-test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.9",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
